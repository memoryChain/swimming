    "license": "SIL Open Font License 1.1",
    "licenseUrl": "https://github.com/notofonts/noto-cjk/blob/Sans2.004/LICENSE",
    "sha256": "d68bafcb48a2707749396aa12bbbd833cb70401f3a9a689fd2902c7e0d295964",
    "cachePath": ".cache/ui-fonts/NotoSansSC-VF.ttf"
  },
  "scan": {
    "roots": [
      "assets/scripts",
      "assets/resources",
      "assets/race"
    ],
    "extensions": [
      ".ts",
      ".json",
      ".scene",
      ".prefab"
    ],
    "alwaysInclude": " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
