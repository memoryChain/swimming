      "family": "ShuiMaster UI",
      "subfamily": "Regular",
      "postscriptName": "ShuiMasterUI-Regular"
    },
    {
      "path": "assets/race/fonts/ShuiMasterUI-SemiBold.ttf",
      "weight": 600,
      "family": "ShuiMaster UI",
      "subfamily": "SemiBold",
      "postscriptName": "ShuiMasterUI-SemiBold"
    }
  ],
  "glyphListPath": "scripts/generated/ui-font-glyphs.txt",
  "manifestPath": "scripts/generated/ui-font-manifest.json"
}
