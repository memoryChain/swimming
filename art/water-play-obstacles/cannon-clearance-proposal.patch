+    /** 保留推拉距离，只把可能退入看台、池岸扶手的机位移回水面上空。 */
+    private constrainCannonCameraPose(): void {
+        const course = this.options.course;
+        // 包含整个核心椭圆及少量留白，而不仅是落点中心。
+        const coreDistance = (Math.hypot(this.cannonTargetX - this.focus.x,
+            course.waterY + 0.05 - this.focus.y, this.cannonTargetZ - this.focus.z) + 1.2) / 0.4383711468;
+        const desiredDistance = Math.max(Vec3.distance(this.cameraPosition, this.focus), coreDistance);
+        const minX = Math.min(course.startX, course.finishX);
+        const maxX = Math.max(course.startX, course.finishX);
+        const halfWidth = Math.max(0, course.poolWidth * 0.5 - 2);
+        this.cameraPosition.x = Math.max(minX, Math.min(maxX, this.cameraPosition.x));
+        this.cameraPosition.z = Math.max(-halfWidth, Math.min(halfWidth, this.cameraPosition.z));
+        const dx = this.cameraPosition.x - this.focus.x;
+        const dz = this.cameraPosition.z - this.focus.z;
+        // 横向收回后改由高度补足距离，避免水球／核心区被挤出画面。
+        // 8m 的水面净空让近景不会贴着最高约 2.5m 的岸边设施拍摄。
+        const height = Math.sqrt(Math.max(0, desiredDistance * desiredDistance - dx * dx - dz * dz));
+        this.cameraPosition.y = Math.max(this.cameraPosition.y, course.waterY + 8, this.focus.y + height);
