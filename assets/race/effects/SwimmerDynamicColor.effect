CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: swimmer-color-vs:vert
      frag: swimmer-color-fs:frag
      properties:
        mainTexture: { value: grey }
        colorMask:   { value: black }
        mainColor:   { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        suitColor:   { value: [0.87, 0.058, 0.043, 1], linear: true, editor: { type: color } }
        capColor:    { value: [0.008, 0.184, 0.807, 1], linear: true, editor: { type: color } }
        # RGB = target skin tone; alpha = whether the blue color-mask channel applies it.
        skinColor:   { value: [1, 1, 1, 0], linear: true, editor: { type: color } }
        # x = 0: RGB mask recolour, x = 1: recolour neutral-white equipment,
        # including the slightly darker fold texels authored into the source.
        recolorParams: { value: [0, 0, 0, 0] }
        # x = water surface world Y, y = tint fade depth (small = crisp edge).
        # z/w unused.
        waterLine:       { value: [0.055, 0.04, 0, 0] }
        # Above-water camera looking through the surface: rgb defines a normalized
        # spectral transmission filter, a = filter strength. Multiplicative filtering
        # preserves material identity (especially black suits) unlike a flat blue mix.
        underwaterColor: { value: [0.212, 0.565, 0.804, 0.30], linear: true, editor: { type: color } }
        # Submerged camera: gentler, white-balanced transmission that keeps nearby
        # skin warm, matching real underwater broadcast footage.
        underwaterViewColor: { value: [0.408, 0.675, 0.808, 0.24], linear: true, editor: { type: color } }
        # x/y = submerged-camera top-light min/max; z/w = above-water-camera min/max.
        # Both ranges are deliberately soft and never approach the old 1.8x blowout.
        underwaterLightParams: { value: [0.34, 1.06, 0.56, 0.96] }
        # Luminance-preserving blue fill for dark body regions:
        # x = submerged-camera strength, y = above-water-camera strength.
        underwaterShadowParams: { value: [0.10, 0.14, 0.0, 0.0] }
        # Distance-based blue absorption for submerged bodies: far swimmers read
        # bluer than near ones (matches real underwater "the further, the bluer").
        # rgb = deep-water blue, a = max blend strength.
        depthFogColor:   { value: [0.149, 0.435, 0.686, 0.45], linear: true, editor: { type: color } }
        # x = distance where the blue starts (m), y = distance for full blue (m),
        # z = enable (0/1). w unused.
        depthFogParams:  { value: [6.0, 24.0, 1.0, 0.0] }
        # Above-waterline haze: when the CAMERA is underwater, a body part sticking
        # out above the surface fades toward this pale washed colour so it reads as
        # poking through the surface rather than a hard cut. a = strength. Only
        # applies when the camera is below the surface; normal above-water race
        # views are untouched.
        aboveWaterColor: { value: [0.412, 0.675, 0.804, 0.45], linear: true, editor: { type: color } }
        # x>0.5 = this draw is the underwater mirror reflection (a camera ABOVE the
        # surface): discard the swimmer's above-water fragments so the reflection
        # only shows the submerged body (no above-water ghost). Set on the fly by
        # WaterRefractionController; 0 for all normal direct/broadcast draws.
        reflectClipParams: { value: [0, 0, 0, 0] }
        # Cel shading (quantised directional light):
        # x = band count (2~4 gives a comic look), y = shadow-side brightness floor
        # (0..1, lower = darker shadow), z = enable (0/1), w = cool shadow-tint strength.
        celParams:       { value: [3, 0.55, 1, 0.25] }
        # Rim light (Fresnel edge glow). rgb = rim colour, a = strength.
        rimColor:        { value: [0.55, 0.72, 1.0, 0.3], linear: true, editor: { type: color } }
        # Rim light shape: x = power (higher = thinner rim), y = enable (0/1). z/w unused.
        rimParams:       { value: [4.0, 1, 0, 0] }
        # Start-dive inner glow. It is composited into the body's own textured
        # pass with Screen blending, so it cannot z-fight with a proxy shell.
        chargeBlue:      { value: [0.05, 0.62, 1.0, 1.0], linear: true, editor: { type: color } }
        chargeYellow:    { value: [1.0, 0.72, 0.04, 1.0], linear: true, editor: { type: color } }
        chargeRed:       { value: [1.0, 0.08, 0.025, 1.0], linear: true, editor: { type: color } }
        # x = display intensity, y = charge progress, z = screen opacity gain,
        # w = subtle pulse speed.
        chargeParams:    { value: [0.0, 0.0, 0.90, 15.0] }
}%

CCProgram swimmer-color-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;
  out vec3 v_worldPos;
  out mediump vec3 v_worldNormal;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    v_uv = a_texCoord;
    vec4 worldPos = matWorld * In.position;
    v_worldPos = worldPos.xyz;
    // Unlike the faceted derivative normal used by cel shading below, this is
    // the model's smooth vertex normal after skeletal skinning. It produces a
    // continuous silhouette mask across low-poly triangle boundaries.
    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
    CC_TRANSFER_FOG(worldPos);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram swimmer-color-fs %{
  #if __VERSION__ < 300
  #extension GL_OES_standard_derivatives : enable
  #endif
  precision highp float;
  #include <legacy/output-standard>
  #include <legacy/fog-fs>
  #include <builtin/uniforms/cc-global>

  in vec2 v_uv;
  in vec3 v_worldPos;
  in mediump vec3 v_worldNormal;
  uniform sampler2D mainTexture;
  uniform sampler2D colorMask;

  uniform SwimmerColor {
    vec4 mainColor;
    vec4 suitColor;
    vec4 capColor;
    vec4 skinColor;
    vec4 recolorParams;
    vec4 waterLine;
    vec4 underwaterColor;
    vec4 underwaterViewColor;
    vec4 underwaterLightParams;
    vec4 underwaterShadowParams;
    vec4 depthFogColor;
    vec4 depthFogParams;
    vec4 aboveWaterColor;
    vec4 reflectClipParams;
    vec4 celParams;
    vec4 rimColor;
    vec4 rimParams;
    vec4 chargeBlue;
    vec4 chargeYellow;
    vec4 chargeRed;
    vec4 chargeParams;
  };

  vec4 frag () {
    // Underwater mirror reflection clip: when this draw is the reflection (a camera
    // ABOVE the surface, flagged by reflectClipParams.x), drop the ABOVE-water
    // fragments so the mirror reflects only the submerged body (no ghost). The
    // camY>waterLine test keeps the direct underwater overlay (camera below the
    // surface) and every above-water/broadcast draw (flag=0) fully intact.
    if (reflectClipParams.x > 0.5 && v_worldPos.y > waterLine.x && cc_cameraPos.y > waterLine.x) {
      discard;
    }
    vec4 baseSample = texture(mainTexture, v_uv);
    vec3 base = SRGBToLinear(baseSample.rgb) * mainColor.rgb;
    vec3 mask = clamp(texture(colorMask, v_uv).rgb, 0.0, 1.0);
    float whiteMin = min(baseSample.r, min(baseSample.g, baseSample.b));
    float whiteMax = max(baseSample.r, max(baseSample.g, baseSample.b));
    float whiteNeutral = 1.0 - smoothstep(0.08, 0.32, whiteMax - whiteMin);
    float whiteKey = smoothstep(0.52, 0.82, whiteMin) * whiteNeutral;
    float whiteKeyMode = step(0.5, recolorParams.x);
    float suitMask = mix(mask.r, whiteKey, whiteKeyMode);
    float capMask = mix(mask.g, 0.0, whiteKeyMode);
    float skinMask = mix(mask.b, 1.0 - whiteKey, whiteKeyMode);
    float capBlend = capMask / max(suitMask + capMask, 0.0001);
    float luminance = dot(base, vec3(0.2126, 0.7152, 0.0722));
    float brightness = clamp(0.34 + sqrt(clamp(luminance / 0.42, 0.0, 1.0)) * 0.76, 0.34, 1.08);
    // AI-authored garment textures contain dark painted fold/triangle lines.
    // Preserve only a very small amount of that luminance so recolouring does
    // not amplify those lines into a visible polygonal web.
    float garmentBrightness = mix(1.0, brightness, 0.10);
    vec3 garment = mix(suitColor.rgb, capColor.rgb, capBlend) * garmentBrightness;
    // Do not multiply by garmentMask a second time: that squared fractional
    // UV-edge coverage and exposed the dark source atlas between triangles.
    float garmentOverride = smoothstep(
        0.015,
        0.12,
        max(suitMask * suitColor.a, capMask * capColor.a)
    );
    vec3 bodyColor = mix(base, garment, garmentOverride);
    vec3 skin = skinColor.rgb * brightness;
    bodyColor = mix(bodyColor, skin, skinMask * skinColor.a);
    // Camera depth is evaluated in the shader so the same material naturally
    // supports both presentation cases without per-frame material writes. Blend
    // over a narrow band to avoid a colour pop while the camera crosses the plane.
    float cameraSubmerge = 1.0 - smoothstep(waterLine.x - 0.12, waterLine.x + 0.04, cc_cameraPos.y);
    float belowness = step(v_worldPos.y, waterLine.x);
    // --- Cel shading: quantise the directional light into flat bands ----------
    // Keep a geometric per-triangle normal for the intentionally faceted cel
    // shading. The charge rim separately uses the smooth skinned vertex normal.
    vec3 celN = normalize(cross(dFdx(v_worldPos), dFdy(v_worldPos)));
    vec3 celV = normalize(cc_cameraPos.xyz - v_worldPos);
    if (dot(celN, celV) < 0.0) celN = -celN; // orient toward the visible side
    // Fixed key-light direction (surface-to-light) roughly matching the stadium
    // sun. Avoids cc_mainLitDir, which is not available in this legacy include
    // set and fails to compile (breaking recolour -> swimmers turn white).
    vec3 celL = normalize(vec3(0.35, 1.0, 0.22));
    float celNdl = dot(celN, celL) * 0.5 + 0.5; // half-lambert, 0..1
    float celBands = max(celParams.x, 1.0);
    float celQ = clamp(floor(celNdl * celBands) / max(celBands - 1.0, 1.0), 0.0, 1.0);
    float celLight = mix(celParams.y, 1.0, celQ);
    vec3 celShaded = bodyColor * celLight;
    // Cool-tint the darker bands slightly for a more illustrative feel.
    celShaded = mix(celShaded, celShaded * vec3(0.92, 0.96, 1.06), (1.0 - celQ) * celParams.w);
    bodyColor = mix(bodyColor, celShaded, step(0.5, celParams.z));
    // --- Rim light: bright Fresnel edge glow (back/side light) ----------------
    // Reuses celN / celV. Brightest where the surface faces away from the
    // camera (silhouette), adding an anime-style backlight halo. Additive.
    float rim = pow(1.0 - clamp(dot(celN, celV), 0.0, 1.0), max(rimParams.x, 0.1));
    // Water scatters the hard silhouette halo. Keep a hint for readability from
    // above and reduce it further for the direct underwater view.
    float submergedRimScale = mix(0.48, 0.28, cameraSubmerge);
    float rimScale = mix(1.0, submergedRimScale, belowness);
    bodyColor += rimColor.rgb * (rim * rimColor.a * step(0.5, rimParams.y) * rimScale);
    // Silhouette-only inner glow using the standard Screen formula:
    // result = 1 - (1 - base) * (1 - overlay).
    // The smooth skinned vertex normal makes the Fresnel edge continuous across
    // low-poly triangles; the centre-facing part of the body stays unchanged.
    if (chargeParams.x > 0.001) {
      vec3 chargeN = normalize(v_worldNormal);
      float chargeNdotV = abs(dot(chargeN, celV));
      // Lower power widens the glow inward while still leaving front-facing
      // central surfaces untouched.
      float innerEdge = pow(1.0 - clamp(chargeNdotV, 0.0, 1.0), 1.8);
      float chargeProgress = clamp(chargeParams.y, 0.0, 1.0);
      vec3 chargeColor = chargeProgress < 0.34
        ? chargeBlue.rgb
        : (chargeProgress < 0.67 ? chargeYellow.rgb : chargeRed.rgb);
      float chargePulse = 0.95 + sin(cc_time.x * chargeParams.w) * 0.05;
      // A narrow hot core boosts only the silhouette-most pixels. The broader
      // inner glow width remains unchanged and the body centre stays untouched.
      float edgeCore = pow(1.0 - clamp(chargeNdotV, 0.0, 1.0), 6.0);
      float screenOpacity = clamp(
        (innerEdge * chargeParams.z + edgeCore * 0.22) * chargeParams.x * chargePulse,
        0.0,
        0.97
      );
      vec3 screenOverlay = chargeColor * screenOpacity;
      vec3 screenBase = clamp(bodyColor, 0.0, 1.0);
      bodyColor = vec3(1.0) - (vec3(1.0) - screenBase) * (vec3(1.0) - screenOverlay);
    }
    // Underwater spectral filtering. Normalize rgb so it describes relative
    // wavelength transmission instead of adding a flat cyan veil. Dark cloth stays
    // dark, while skin loses some red without becoming grey-white. The underwater
    // camera uses the gentler white-balanced preset selected above.
    vec4 waterFilter = mix(underwaterColor, underwaterViewColor, cameraSubmerge);
    float filterPeak = max(max(waterFilter.r, waterFilter.g), max(waterFilter.b, 0.0001));
    vec3 filterRgb = waterFilter.rgb / filterPeak;
    vec3 transmission = mix(vec3(1.0), filterRgb, waterFilter.a);
    bodyColor *= mix(vec3(1.0), transmission, belowness);
    // Broad diffuse light from the surface, evaluated with the real skinned normal.
    // The restrained normal range keeps readable form without burning the
    // up-facing torso and limbs to the previous grey-white highlight.
    // Use the true upward normal directly. The old half-Lambert remap turned a
    // vertical side normal (Y=0) into 50% light, lifting the whole body. Now only
    // surfaces that genuinely face upward enter the bright top-light lobe; sides
    // and undersides stay at the dark ambient floor.
    float upFacing = normalize(v_worldNormal).y;
    float topLightT = smoothstep(0.05, 0.72, upFacing);
    float lightMin = mix(underwaterLightParams.z, underwaterLightParams.x, cameraSubmerge);
    float lightMax = mix(underwaterLightParams.w, underwaterLightParams.y, cameraSubmerge);
    float normalLight = mix(lightMin, lightMax, topLightT);
    // Every submerged fragment keeps the complete surface top light regardless of
    // vertical depth. Only its real surface orientation changes the brightness.
    bodyColor *= mix(1.0, normalLight, belowness);
    // Dark underwater skin should pick up a slight blue ambient cast rather than
    // remaining a plain red-brown shadow. Build a water-hued colour with the same
    // luminance as the current fragment, then blend it only into dark regions.
    // Because the target luminance is preserved, this changes hue without lifting
    // the shadow or turning black garments into a flat blue patch.
    vec3 lumaWeights = vec3(0.2126, 0.7152, 0.0722);
    float shadowLuma = dot(bodyColor, lumaWeights);
    float filterLuma = max(dot(filterRgb, lumaWeights), 0.001);
    vec3 waterShadow = filterRgb * (shadowLuma / filterLuma);
    float shadowMask = 1.0 - smoothstep(0.10, 0.32, shadowLuma);
    float shadowBlue = mix(underwaterShadowParams.y, underwaterShadowParams.x, cameraSubmerge);
    bodyColor = mix(bodyColor, waterShadow, shadowMask * shadowBlue * belowness);
    // Distance-based blue absorption: submerged bodies fade toward deep-water
    // blue with camera distance, so far competitors read markedly bluer than the
    // nearby swimmer (real "the further underwater, the bluer" look). Only below
    // the waterline, and only when enabled.
    float depthDist = length(cc_cameraPos.xyz - v_worldPos);
    float depthT = clamp((depthDist - depthFogParams.x) / max(depthFogParams.y - depthFogParams.x, 0.001), 0.0, 1.0);
    float depthAmt = depthT * depthFogColor.a * belowness * step(0.5, depthFogParams.z);
    bodyColor = mix(bodyColor, depthFogColor.rgb, depthAmt);
    // Above-waterline haze: when the CAMERA is underwater, a body part above the
    // surface fades toward aboveWaterColor so it reads as poking through the
    // surface instead of a hard glitch. camUnder gates it out of above-water
    // race views (there the above-water body must render normally).
    float aboveness = step(waterLine.x, v_worldPos.y);
    bodyColor = mix(bodyColor, aboveWaterColor.rgb, aboveness * cameraSubmerge * aboveWaterColor.a);
    vec4 outputColor = vec4(bodyColor, baseSample.a * mainColor.a);
    CC_APPLY_FOG(outputColor);
    return CCFragOutput(outputColor);
  }
}%
