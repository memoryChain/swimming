CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: lane-float-clip-vs:vert
      frag: lane-float-clip-fs:frag
      properties:
        mainTexture:    { value: grey }
        mainColor:      { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        tilingOffset:   { value: [1, 1, 0, 0] }
        # xyz = protagonist world position, w = clip enabled.
        laneClipCenter: { value: [0, 0, 0, 0] }
        # xy = normalized world XZ body axis, z = capsule half-length, w = radius.
        laneClipAxis:   { value: [1, 0, 1.2, 0.52] }
}%

CCProgram lane-float-clip-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;
  out vec3 v_worldPos;

  uniform LaneFloatClip {
    vec4 mainColor;
    vec4 tilingOffset;
    vec4 laneClipCenter;
    vec4 laneClipAxis;
  };

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    vec4 worldPos = matWorld * position;
    v_worldPos = worldPos.xyz;
    CC_TRANSFER_FOG(worldPos);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram lane-float-clip-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <legacy/fog-fs>

  in vec2 v_uv;
  in vec3 v_worldPos;
  uniform sampler2D mainTexture;

  uniform LaneFloatClip {
    vec4 mainColor;
    vec4 tilingOffset;
    vec4 laneClipCenter;
    vec4 laneClipAxis;
  };

  vec4 frag () {
    if (laneClipCenter.w > 0.5) {
      vec2 axis = laneClipAxis.xy;
      vec2 fromCenter = v_worldPos.xz - laneClipCenter.xz;
      float along = clamp(dot(fromCenter, axis), -laneClipAxis.z, laneClipAxis.z);
      vec2 fromCapsule = fromCenter - axis * along;
      if (dot(fromCapsule, fromCapsule) < laneClipAxis.w * laneClipAxis.w) {
        discard;
      }
    }

    vec4 sampleColor = texture(mainTexture, v_uv);
    vec4 outputColor = vec4(SRGBToLinear(sampleColor.rgb) * mainColor.rgb, sampleColor.a * mainColor.a);
    CC_APPLY_FOG(outputColor);
    return CCFragOutput(outputColor);
  }
}%
