CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: glow-vs
      frag: glow-fs
      priority: max - 25
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        lineWidth: { value: 6, target: glowParams.x }
        flashStrength: { value: 0, target: flashParams.x }
        baseColor: { value: [1.0, 0.78, 0.15, 1.0], linear: true, editor: { type: color } }
}%

CCProgram surface-vertex-glow %{
  uniform GlowVert {
    vec4 glowParams;
  };

  #define CC_SURFACES_VERTEX_MODIFY_LOCAL_POS
  vec3 SurfacesVertexModifyLocalPos(in SurfacesStandardVertexIntermediate In)
  {
    return In.position.xyz + normalize(In.normal) * glowParams.x * 0.001;
  }
}%

CCProgram surface-fragment-glow %{
  uniform GlowFrag {
    vec4 baseColor;
    vec4 flashParams;
  };

  #define CC_SURFACES_FRAGMENT_MODIFY_BASECOLOR_AND_TRANSPARENCY
  vec4 SurfacesFragmentModifyBaseColorAndTransparency()
  {
    float flash = clamp(flashParams.x, 0.0, 1.0);
    vec4 color = baseColor;
    color.rgb = SRGBToLinear(color.rgb) * (1.0 + flash * 0.85);
    color.a = flash * 0.26;
    return color;
  }
}%

CCProgram glow-vs %{
  precision highp float;
  #include <surfaces/effect-macros/silhouette-edge>
  #include <surfaces/includes/common-vs>
  #include <surface-vertex-glow>
  #include <shading-entries/main-functions/misc/silhouette-edge-vs>
}%

CCProgram glow-fs %{
  precision highp float;
  #include <surfaces/effect-macros/silhouette-edge>
  #include <surfaces/includes/common-fs>
  #include <surface-fragment-glow>
  #include <shading-entries/main-functions/misc/silhouette-edge-fs>
}%
