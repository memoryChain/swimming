CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: lane-float-cutout-vs:vert
      frag: lane-float-cutout-fs:frag
      rasterizerState:
        cullMode: back
      depthStencilState:
        depthTest: true
        depthWrite: true
      properties:
        mainTexture:   { value: white }
        mainColor:     { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        tilingOffset:  { value: [1, 1, 0, 0] }
        # xy = player upper-body world XZ, z = enabled, w = solid-cutout radius ratio.
        playerCutout:  { value: [0, 0, 0, 0.72] }
        # xy = player forward direction XZ, z = along-body radius, w = side radius.
        cutoutShape:   { value: [1, 0, 1.05, 0.55] }
        # x = world water surface Y, y = enable flag.
        waterLine:     { value: [0.055, 1.0, 0.0, 0.0] }
        # RGB = underwater tint in linear space, A = blend strength.
        underwaterColor: { value: [0.05, 0.34, 0.62, 0.72], linear: true, editor: { type: color } }
}%

CCProgram lane-float-cutout-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;
  out vec3 v_worldPos;
  out float v_floatShade;

  uniform LaneFloatCutoutVert {
    vec4 tilingOffset;
  };

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    // 浮漂圆周 UV：底部 V=0/1，顶部 V=0.5。
    // 每个顶点计算固定顶光，插值到像素；无需法线、灯光或第二张纹理。
    float topFacing = -cos(a_texCoord.y * 6.28318530718);
    v_floatShade = 0.62 + 0.38 * max(topFacing, 0.0);
    vec4 worldPos = matWorld * position;
    v_worldPos = worldPos.xyz;
    CC_TRANSFER_FOG(worldPos);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram lane-float-cutout-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <legacy/fog-fs>

  in vec2 v_uv;
  in vec3 v_worldPos;
  in float v_floatShade;
  uniform sampler2D mainTexture;

  uniform LaneFloatCutoutFrag {
    vec4 mainColor;
    vec4 playerCutout;
    vec4 cutoutShape;
    vec4 waterLine;
    vec4 underwaterColor;
  };

  // Stable screen-space noise used as a tiny screen-door transition. The core
  // of the ellipse is fully discarded; only its narrow rim uses this pattern.
  float screenDoor(vec2 pixel) {
    vec2 cell = floor(pixel);
    return fract(52.9829189 * fract(dot(cell, vec2(0.06711056, 0.00583715))));
  }

  vec4 frag () {
    if (playerCutout.z > 0.5) {
      vec2 delta = v_worldPos.xz - playerCutout.xy;
      vec2 forward = normalize(cutoutShape.xy);
      vec2 side = vec2(-forward.y, forward.x);
      float along = dot(delta, forward) / max(0.01, cutoutShape.z);
      float across = dot(delta, side) / max(0.01, cutoutShape.w);
      float ellipseDistance = length(vec2(along, across));
      float visibility = smoothstep(playerCutout.w, 1.0, ellipseDistance);
      if (visibility <= 0.001 || visibility < screenDoor(gl_FragCoord.xy)) {
        discard;
      }
    }

    vec4 sampleColor = texture(mainTexture, v_uv);
    // 接缝稍提亮，避免细密黑条；体积感来自圆周明暗而非加深每条接缝。
    vec3 beadColor = mix(vec3(1.0), SRGBToLinear(sampleColor.rgb), 0.88);
    vec3 baseColor = beadColor * mainColor.rgb * v_floatShade;
    float belowWater = step(v_worldPos.y, waterLine.x) * step(0.5, waterLine.y);
    vec3 submerged = mix(baseColor, underwaterColor.rgb, underwaterColor.a);
    vec4 outputColor = vec4(mix(baseColor, submerged, belowWater), sampleColor.a * mainColor.a);
    CC_APPLY_FOG(outputColor);
    return CCFragOutput(outputColor);
  }
}%
