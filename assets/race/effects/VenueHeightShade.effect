// Unlit venue-stand shading: darkens grandstand / wall geometry by BOTH world
// height and horizontal distance from the pool, PER-PIXEL in the fragment shader
// (no readMesh, no runtime mesh rebuild — works on device where mesh CPU data is
// released). Bright poolside/low, fading dark toward the top and far corners.
// The visible colour (or a wall tint) is passed in via mainColor/mainTexture by
// StandHeightShade.ts; this effect only multiplies it by the height/distance
// brightness gradient.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: venue-shade-vs:vert
      frag: venue-shade-fs:frag
      rasterizerState:
        cullMode: none
      properties:
        mainTexture: { value: white }
        mainColor:   { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        # x = pool minX, y = pool maxX, z = pool halfZ, w = near-keep metres.
        poolRect:    { value: [0.0, 50.0, 10.5, 6.0] }
        # x = min world Y, y = height span, z = horizontal-distance span, w unused.
        heightRange: { value: [0.0, 20.0, 20.0, 0.0] }
        # x = bottom brightness, y = top brightness, z = height gamma, w = dist gamma.
        shadeCurve:  { value: [1.0, 0.15, 0.7, 0.85] }
}%

CCProgram venue-shade-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out vec3 v_worldPos;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord;
    vec4 worldPos = matWorld * position;
    v_worldPos = worldPos.xyz;
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram venue-shade-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  in vec2 v_uv;
  in vec3 v_worldPos;
  #if USE_TEXTURE
  uniform sampler2D mainTexture;
  #endif

  uniform VenueShade {
    vec4 mainColor;
    vec4 poolRect;
    vec4 heightRange;
    vec4 shadeCurve;
  };

  vec4 frag () {
    // Match builtin-unlit / ToonProp colour handling: linear mainColor +
    // SRGBToLinear on the sRGB texture.
    #if USE_TEXTURE
    vec4 texel = texture(mainTexture, v_uv);
    vec3 base = SRGBToLinear(texel.rgb) * mainColor.rgb;
    float alpha = texel.a * mainColor.a;
    #else
    vec3 base = mainColor.rgb;
    float alpha = mainColor.a;
    #endif

    float minY = heightRange.x;
    float spanY = max(heightRange.y, 0.001);
    float spanDist = max(heightRange.z, 0.001);
    float nearKeep = poolRect.w;

    // Height factor (0 at the lowest stand, 1 at the top), with gamma.
    float hp = pow(clamp((v_worldPos.y - minY) / spanY, 0.0, 1.0), shadeCurve.z);

    // Horizontal distance from the pool rectangle, with a near-keep dead zone.
    float dx = v_worldPos.x < poolRect.x
      ? poolRect.x - v_worldPos.x
      : (v_worldPos.x > poolRect.y ? v_worldPos.x - poolRect.y : 0.0);
    float az = abs(v_worldPos.z);
    float dz = az > poolRect.z ? az - poolRect.z : 0.0;
    float dist = sqrt(dx * dx + dz * dz);
    float dp = pow(clamp((dist - nearKeep) / spanDist, 0.0, 1.0), shadeCurve.w);

    // Being either high OR far darkens the pixel.
    float t = max(hp, dp);
    float b = shadeCurve.x + (shadeCurve.y - shadeCurve.x) * t;

    return CCFragOutput(vec4(base * b, alpha));
  }
}%
