// Unlit venue-stand shading driven by a BAKED per-vertex brightness (COLOR_0).
// The arena dimming (bright poolside/low, dark high/far) is baked into vertex
// colours by sceneresource/export-flatcolor-venue-glb.py, so there is NO runtime
// height/distance shading here — this is a fixed scene with fixed lighting. The
// visible colour + optional texture come from StandHeightShade.ts; the bleacher
// atlas keeps white vertex colours so its authored tiers stay unchanged.
// 池岸和娱乐漂浮物变体按世界水线染色；普通看台保持原有烘焙明暗。
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: venue-shade-vs:vert
      frag: venue-shade-fs:frag
      rasterizerState:
        cullMode: none
      properties:
        mainTexture: { value: white }
        mainColor:   { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        # 池岸道具变体使用世界水线；普通看台不编译这段逻辑。
        waterLine: { value: [0.055, 1, 0, 0] }
        underwaterColor: { value: [0.05, 0.34, 0.62, 0.72], linear: true, editor: { type: color } }
}%

CCProgram venue-shade-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #if USE_TEXTURE
  out vec2 v_uv;
  #endif
  #if USE_POOLSIDE_WATERLINE || USE_FLOATING_VERTEX_COLOR
  out float v_worldY;
  #endif
  #if !USE_POOLSIDE_WATERLINE
  in vec4 a_color;
  out vec4 v_color;
  #endif

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    #if USE_TEXTURE
    v_uv = a_texCoord;
    #endif
    vec4 worldPos = matWorld * position;
    #if USE_POOLSIDE_WATERLINE || USE_FLOATING_VERTEX_COLOR
    v_worldY = worldPos.y;
    #endif
    #if !USE_POOLSIDE_WATERLINE
    v_color = a_color;
    #endif
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram venue-shade-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  #if USE_TEXTURE
  in vec2 v_uv;
  #endif
  #if USE_POOLSIDE_WATERLINE || USE_FLOATING_VERTEX_COLOR
  in float v_worldY;
  #endif
  #if !USE_POOLSIDE_WATERLINE
  in vec4 v_color;
  #endif
  #if USE_TEXTURE
  uniform sampler2D mainTexture;
  #endif

  uniform VenueShade {
    vec4 mainColor;
    vec4 waterLine;
    vec4 underwaterColor;
  };

  vec4 frag () {
    // Match builtin-unlit / ToonProp colour handling: linear mainColor +
    // SRGBToLinear on the sRGB texture.
    #if USE_TEXTURE
    vec4 texel = texture(mainTexture, v_uv);
    vec3 base = SRGBToLinear(texel.rgb) * mainColor.rgb;
    float alpha = texel.a * mainColor.a;
    #else
    vec3 base = mainColor.rgb;
    float alpha = mainColor.a;
    #endif
    // Baked arena dimming: per-vertex brightness multiplier (COLOR_0, linear).
    #if USE_FLOATING_VERTEX_COLOR && !USE_POOLSIDE_WATERLINE
    // Blender 导出的 glTF COLOR_0 已是线性值，不重复做 sRGB 转换。
    base *= v_color.rgb;
    alpha *= v_color.a;
    #endif
    #if USE_POOLSIDE_WATERLINE || USE_FLOATING_VERTEX_COLOR
    // 水上保留本色，仅对世界水线以下的片元叠加与浮漂一致的水色。
    float belowWater = step(v_worldY, waterLine.x) * step(0.5, waterLine.y);
    base = mix(base, underwaterColor.rgb, belowWater * underwaterColor.a);
    return CCFragOutput(vec4(base, alpha));
    #else
    return CCFragOutput(vec4(base * v_color.rgb, alpha));
    #endif
  }
}%
