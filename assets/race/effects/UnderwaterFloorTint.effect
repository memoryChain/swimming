// Unlit pool-floor material with distance-based blue absorption. Near the camera
// the tiles read close to their base colour; far away they fade toward a deep
// blue, with a smooth gradient in between. The distance is measured PER-PIXEL
// from cc_cameraPos, so the gradient tracks the moving camera automatically
// (no engine fog, no shader-variant recompile hitch). Used for the submerged
// pool floor / walls, driven by WaterRefractionController.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: uw-floor-vs:vert
      frag: uw-floor-fs:frag
      properties:
        mainTexture: { value: white }
        mainColor:   { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        # Deep-water blue the far end fades toward (rgb) + max blend strength (a).
        depthColor:  { value: [0.031, 0.329, 0.573, 1.0], linear: true, editor: { type: color } }
        # x = distance where the blue starts (m), y = distance for full blue (m),
        # z = enable (0/1, off above water). w unused.
        depthParams: { value: [0.0, 18.0, 0.0, 0.0] }
        # x = world waterline, y = enable the above-water white cap (walls only).
        # The cap keeps the exposed tile strip white while the submerged part
        # continues to use the live pool-blue tint.
        waterLineParams: { value: [0.055, 0.0, 0.0, 0.0] }
}%

CCProgram uw-floor-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out vec3 v_worldPos;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord;
    vec4 worldPos = matWorld * position;
    v_worldPos = worldPos.xyz;
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram uw-floor-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  in vec2 v_uv;
  in vec3 v_worldPos;
  #if USE_TEXTURE
  uniform sampler2D mainTexture;
  #endif

    uniform UwFloor {
        vec4 mainColor;
        vec4 depthColor;
        vec4 depthParams;
        vec4 waterLineParams;
  };

  vec4 frag () {
    // Match builtin-unlit / ToonProp colour handling: linear mainColor +
    // SRGBToLinear on the sRGB texture, so the floor colours tuned against
    // builtin-unlit (and the water tint that refracts them) render identically.
    #if USE_TEXTURE
    vec4 texel = texture(mainTexture, v_uv);
    vec3 base = SRGBToLinear(texel.rgb) * mainColor.rgb;
    float alpha = texel.a * mainColor.a;
    #else
    vec3 base = mainColor.rgb;
    float alpha = mainColor.a;
    #endif
    // Distance-based blue absorption toward deepColor: near = base tile colour,
    // far = deep blue, smooth gradient. Tracks the moving camera via cc_cameraPos.
    float dist = length(cc_cameraPos.xyz - v_worldPos);
    float absorptionDist = max(dist - depthParams.x, 0.0);
    // Asymptotic absorption has no hard far endpoint and no fast-changing middle
    // band. At depthParams.y it is about 80% toward the far colour, then continues
    // approaching it gradually. The squared rational form avoids a per-pixel exp().
    float absorptionScale = max((depthParams.y - depthParams.x) * 0.5, 0.001);
    float distSq = absorptionDist * absorptionDist;
    float t = distSq / (distSq + absorptionScale * absorptionScale);
    float amt = t * depthColor.a * step(0.5, depthParams.z);
    vec3 color = mix(base, depthColor.rgb, amt);
    // Pool walls share one continuous quad across the waterline. Keep only the
    // exposed upper strip white; underwater fragments retain the tuned blue.
    float aboveWater = step(waterLineParams.x, v_worldPos.y);
    color = mix(color, vec3(1.0), aboveWater * step(0.5, waterLineParams.y));
    return CCFragOutput(vec4(color, alpha));
  }
}%
