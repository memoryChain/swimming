CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: splash-vs:vert
      frag: splash-fs:frag
      priority: max - 20
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        surfaceTexture: { value: white }
        foamColor:    { value: [0.86, 0.98, 1.0, 0.82], linear: true, editor: { type: color } }
        rippleColor:  { value: [0.15, 0.76, 0.96, 0.48], linear: true, editor: { type: color } }
        splashParams: { value: [0.0, 0.0, 0.0, 0.0] }
        shapeParams:  { value: [0.25, 0.60, 0.0, 0.0] }
}%

CCProgram splash-vs %{
  precision highp float;

  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out float v_sideFade;

  uniform SplashParams {
    vec4 foamColor;
    vec4 rippleColor;
    vec4 splashParams;
    vec4 shapeParams;
  };

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 world = matWorld * position;
    v_uv = a_texCoord;
    v_sideFade = 1.0;
    return cc_matProj * (cc_matView * world);
  }
}%

CCProgram splash-fs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>

  in vec2 v_uv;
  in float v_sideFade;

  uniform SplashParams {
    vec4 foamColor;
    vec4 rippleColor;
    vec4 splashParams;
    vec4 shapeParams;
  };

  uniform sampler2D surfaceTexture;

  vec4 frag () {
    // 一次图集采样：左格为短尾流，右格为断续波纹。
    float rippleMode = shapeParams.z;
    float progress = clamp(shapeParams.w, 0.0, 1.0);
    float spread = mix(0.62, 1.0, progress);
    vec2 tileUv = mix(v_uv, (v_uv - 0.5) / spread + 0.5, rippleMode);
    float inside = step(0.0, tileUv.x) * step(tileUv.x, 1.0)
                 * step(0.0, tileUv.y) * step(tileUv.y, 1.0);
    vec2 atlasUv = vec2(clamp(tileUv.x, 0.002, 0.998) * 0.5 + rippleMode * 0.5,
                        clamp(tileUv.y, 0.002, 0.998));
    vec4 art = texture(surfaceTexture, atlasUv);
    float strength = clamp(splashParams.x, 0.0, 1.0);
    float pulse = 0.86 + 0.14 * sin(cc_time.x * 7.0 + splashParams.w);
    float wakeAlpha = (0.30 + 0.40 * strength) * pulse;
    float rippleAlpha = (1.0 - smoothstep(0.1, 1.0, progress)) * 0.65;
    vec3 tint = mix(rippleColor.rgb, foamColor.rgb, 0.94);
    return CCFragOutput(vec4(art.rgb * tint, min(1.0, art.a * 2.2) * inside * mix(wakeAlpha, rippleAlpha, rippleMode)));
  }
}%
