CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: water-vs:vert
      frag: water-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        deepColor:       { value: [0.03, 0.42, 0.74, 0.60], linear: true, editor: { type: color } }
        shallowColor:    { value: [0.14, 0.78, 0.94, 0.30], linear: true, editor: { type: color } }
        foamColor:       { value: [0.92, 1.00, 1.00, 0.60], linear: true, editor: { type: color } }
        causticColor:    { value: [0.70, 1.00, 1.00, 1.00], linear: true, editor: { type: color } }
        waveA:           { value: [0.018, 0.45, 0.80, 1.00] }
        waveB:           { value: [0.011, 1.20, 1.15, 0.58] }
        foamParams:      { value: [0.80, 1.35, 0.10, 0.22] }
        causticParams:   { value: [7.00, 0.35, 2.60, 0.55] }
        refractionParams: { value: [0.0003, 0.00, 0.32, 25.50] }
        # rgb = a flat, explicit water surface colour; a = how strongly it overrides
        # the refraction/caustic/foam detail (0 = pure refraction, 1 = solid colour).
        # Default = bright azure pool blue (Mario & Sonic 2020 reference).
        waterColor:      { value: [0.011, 0.27, 0.71, 0.72], linear: true, editor: { type: color } }
        # Fake reflections of individual ceiling lamps. x/y = X/Z spacing,
        # z = spot radius, w = intensity (0 disables it on lower tiers).
        roofReflectionParams: { value: [6.20, 5.00, 0.42, 0.26] }
        roofReflectionColor: { value: [0.72, 0.92, 1.00, 1.00], linear: true, editor: { type: color } }
        # x/y = safe world-Z bounds, z = boundary half-width, w = enabled.
        laneLockdownParams: { value: [0.00, 0.00, 0.075, 0.00] }
        laneLockdownWarningParams: { value: [0.00, 0.00, 0.075, 0.00] }
        laneLockdownClosedColor: { value: [0.025, 0.034, 0.074, 0.88], linear: true, editor: { type: color } }
        laneLockdownBoundaryColor: { value: [0.485, 0.791, 0.888, 1.00], linear: true, editor: { type: color } }
        refractionMap:   { value: grey }
        # Planar reflection of the underwater scene, rendered by a mirror camera
        # into a RenderTexture (see WaterRefractionController). Sampled by the
        # underwater-looking-up branch so the underside of the surface acts like a
        # mirror (total internal reflection).
        reflectionMap:   { value: grey }
        # x = mirror strength (0 = no reflection, keeps the old Snell tint),
        # y = flip U (1/0), z = flip V (1/0), w = extra wobble scale for the
        # underside distortion (bigger = more violent refraction ripple).
        reflectionParams: { value: [0.90, 1.00, 0.00, 1.60] }
        # x = how strongly the reflection is tinted toward deepColor (0 = raw
        # reflection / whiter, 1 = fully deep-water blue). y/z/w unused.
        reflectionTint: { value: [0.45, 0.00, 0.00, 0.00] }
}%

CCProgram water-vs %{
  precision highp float;

  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec3 v_worldPos;
  out vec2 v_waterUv;
  out float v_wave;
  out vec4 v_screenPos;

  uniform WaterParams {
    vec4 deepColor;
    vec4 shallowColor;
    vec4 foamColor;
    vec4 causticColor;
    vec4 waveA;
    vec4 waveB;
    vec4 foamParams;
    vec4 causticParams;
    vec4 refractionParams;
    vec4 waterColor;
    vec4 roofReflectionParams;
    vec4 roofReflectionColor;
    vec4 laneLockdownParams;
    vec4 laneLockdownWarningParams;
    vec4 laneLockdownClosedColor;
    vec4 laneLockdownBoundaryColor;
  };

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    float t = cc_time.x;
    float waveX = sin(position.x * waveA.y + t * waveA.z);
    float waveZ = sin(position.z * waveB.y - t * waveB.z);
    float cross = sin((position.x + position.z * 1.7) * 0.18 + t * 0.7);
    float wave = waveX * waveA.x + waveZ * waveB.x + cross * 0.006;
    position.y += wave;

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 world = matWorld * position;
    v_worldPos = world.xyz;
    v_waterUv = position.xz * 0.05;
    v_wave = wave;

    vec4 clip = cc_matProj * (cc_matView * world);
    v_screenPos = clip;

    CC_TRANSFER_FOG(world);
    return clip;
  }
}%

CCProgram water-fs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <legacy/fog-fs>

  in vec3 v_worldPos;
  in vec2 v_waterUv;
  in float v_wave;
  in vec4 v_screenPos;

  uniform WaterParams {
    vec4 deepColor;
    vec4 shallowColor;
    vec4 foamColor;
    vec4 causticColor;
    vec4 waveA;
    vec4 waveB;
    vec4 foamParams;
    vec4 causticParams;
    vec4 refractionParams;
    vec4 waterColor;
    vec4 roofReflectionParams;
    vec4 roofReflectionColor;
    vec4 laneLockdownParams;
    vec4 laneLockdownWarningParams;
    vec4 laneLockdownClosedColor;
    vec4 laneLockdownBoundaryColor;
  };

  // Underwater scene (pool floor) rendered by the refraction camera into a
  // RenderTexture, sampled with a wave-driven offset so the floor wobbles.
  // Swimmers are drawn by a separate on-top camera, so this water is fully
  // opaque and only refracts the floor.
  uniform sampler2D refractionMap;

  // Planar reflection of the underwater scene (floor + swimmers) rendered from
  // the mirror of the main camera. Sampled only when the camera is below the
  // surface so the underside reads as a rippling mirror.
  uniform sampler2D reflectionMap;
  uniform WaterReflect {
    vec4 reflectionParams;
    vec4 reflectionTint;
  };

  #define MAX_DISTURB 8
  // Local turbulence sources (the swimmers). Each active slot: xy = world XZ,
  // z = strength (0 = inactive slot). disturbParams: x = influence radius,
  // y = chaotic ripple frequency, z = churn strength added to the refraction
  // offset, w = enabled. WaterRefractionController enables this branch only for
  // top-view shots; normal shots stay on the calm open-water distortion.
  // NOTE: the array length must be a literal (Cocos EFX rejects a #define here);
  // keep it equal to MAX_DISTURB above.
  uniform WaterDisturb {
    vec4 disturbParams;
    vec4 swimmerDisturb[8];
  };

  // Irregular water wobble: several sine waves at NON-harmonic frequencies and
  // varied propagation directions summed together. Because the frequencies are
  // not integer multiples, the pattern never lines up into a regular sine
  // zigzag, so the refracted floor ripples like real water instead. p is world
  // XZ pre-scaled by the frequency knob.
  vec2 waterWobble(vec2 p, float t) {
    vec2 d = vec2(0.0);
    d += vec2( 0.70,  0.25) * sin(dot(p, vec2( 1.00,  0.55))        + t * 1.30);
    d += vec2(-0.55,  0.80) * sin(dot(p, vec2(-0.70,  1.10)) * 1.73 - t * 1.10);
    d += vec2( 0.60, -0.50) * sin(dot(p, vec2( 1.30, -0.85)) * 2.61 + t * 1.90);
    d += vec2( 0.40,  0.50) * sin(dot(p, vec2( 0.45,  1.60)) * 3.79 - t * 2.40);
    return d;
  }

  vec4 frag () {
    float t = cc_time.x;

    // Grazing-angle brightening so the far end reads as a lighter sky-cyan.
    vec3 viewDir = normalize(cc_cameraPos.xyz - v_worldPos);
    float fresnel = pow(1.0 - clamp(viewDir.y, 0.0, 1.0), 3.0);

    // Underwater-looking-up view: when the camera is below the surface, the
    // underside of the water acts like an OPAQUE MIRROR at EVERY angle — it
    // reflects the underwater scene (swimmers + pool) with a heavy rippling
    // distortion, so the swimmers' reflection is visible from any viewpoint (no
    // Snell-window see-through fade).
    if (cc_cameraPos.y < v_worldPos.y) {
      // Screen-space UV of this surface pixel (same basis the refraction uses).
      vec2 ndc = v_screenPos.xy / max(abs(v_screenPos.w), 1e-4);
      vec2 mirrorUV = ndc * 0.5 + 0.5;
      // More violent underside ripple: a larger-amplitude irregular wobble.
      float fwU = refractionParams.w * reflectionParams.w;
      vec2 underWobble = waterWobble(v_worldPos.xz * fwU, t) * 0.6;
      mirrorUV += underWobble * (refractionParams.x * 3.2);
      if (reflectionParams.y > 0.5) mirrorUV.x = 1.0 - mirrorUV.x;
      if (reflectionParams.z > 0.5) mirrorUV.y = 1.0 - mirrorUV.y;
      mirrorUV = clamp(mirrorUV, vec2(0.001), vec2(0.999));
      vec3 mirror = texture(reflectionMap, mirrorUV).rgb;
      // Push the reflection toward the deep pool blue so the bright/near-white
      // reflected floor reads as blue water rather than a white glare. Strength
      // is the tunable '反光蓝浓度' slider (reflectionTint.x).
      mirror = mix(mirror, deepColor.rgb, clamp(reflectionTint.x, 0.0, 1.0));
      // reflectionParams.x blends between the flat deep-water tint and the mirror
      // (1 = full mirror). No view-angle fade, so the reflection reads at all angles.
      vec3 underColor = mix(deepColor.rgb, mirror, clamp(reflectionParams.x, 0.0, 1.0));
      // Fully opaque (no see-through Snell window).
      vec4 uo = vec4(underColor, 1.0);
      CC_APPLY_FOG(uo);
      return CCFragOutput(uo);
    }

    // Real refraction: sample the underwater floor from the RT at this pixel's
    // screen position, offset by a wave-driven distortion so the floor wobbles.
    // refractionParams.y toggles the Y-flip (RT is flipped on some backends).
    vec2 ndc = v_screenPos.xy / max(abs(v_screenPos.w), 1e-4);
    vec2 screenUV = ndc * 0.5 + 0.5;
    if (refractionParams.y > 0.5) {
      screenUV.y = 1.0 - screenUV.y;
    }
    // Open-water refraction: an irregular, small-amplitude wobble (see
    // waterWobble) instead of a regular sine, so the refracted lane lines ripple
    // naturally. A slowly-varying amplitude makes the lines look thick in some
    // stretches and thin in others, like real refracted pool markings.
    float fw = refractionParams.w;
    float ampVar = 0.7 + 0.3 * sin(dot(v_worldPos.xz, vec2(0.7, 0.45)) + t * 0.35);
    vec2 baseWobble = waterWobble(v_worldPos.xz * fw, t) * (0.34 * ampVar);
    // Local wake: sum how close this water pixel is to each swimmer, then layer
    // high-frequency chaotic ripples weighted by that proximity, so the water
    // churns finely around swimmers while the open pool keeps the calm wobble.
    vec2 dudv = baseWobble;
    // This condition is uniform across the draw. Normal camera shots coherently
    // skip both the eight-source loop and the second four-octave wobble.
    if (disturbParams.w > 0.5) {
      float disturb = 0.0;
      for (int i = 0; i < MAX_DISTURB; i++) {
        vec2 sd = v_worldPos.xz - swimmerDisturb[i].xy;
        float r2 = max(disturbParams.x * disturbParams.x, 1e-4);
        float prox = 1.0 - clamp(dot(sd, sd) / r2, 0.0, 1.0);
        disturb += prox * prox * swimmerDisturb[i].z;
      }
      disturb = clamp(disturb, 0.0, 1.5);
      vec2 chaos = waterWobble(v_worldPos.xz * (fw * 2.7) + vec2(11.3, 4.1), t * 2.1);
      dudv += chaos * (disturb * disturbParams.z * 0.5);
    }
    vec2 refractUV = clamp(screenUV + dudv * refractionParams.x, vec2(0.001), vec2(0.999));
    vec3 background = texture(refractionMap, refractUV).rgb;

    // Start from the crisp refracted floor so the pool bottom (lane lines, tiles)
    // stays visible THROUGH the water — that legibility is what makes water read as
    // clear/transparent instead of a flat blue wash.
    vec3 floorSeen = background;
    // Brighten + add contrast to the refracted floor so the pool bottom reads as
    // bright tiles + crisp lane lines (like Mario's white-tiled pool). This is what
    // makes the transparent water look luminous instead of dull/dark — the water
    // is only as bright as the floor seen through it.
    floorSeen = clamp((floorSeen - 0.5) * 1.35 + 0.5, 0.0, 1.0) * 1.08;

    // Depth-style blue absorption: the more grazing the view, the longer the sight
    // line travels through water, so it tints bluer (far/grazing = blue, looking
    // straight down = clear to the floor). waterColor.rgb = the pool blue,
    // waterColor.a = tint strength (the "water colour strength" knob).
    float viewUp = clamp(viewDir.y, 0.0, 1.0);
    float grazeFactor = mix(1.0, 0.34, viewUp);
    float tintAmt = clamp(waterColor.a * grazeFactor + 0.26, 0.0, 1.0);
    vec3 color = mix(floorSeen, waterColor.rgb, tintAmt);

    // Surface life on top: grazing sky glint + wave sheen + a few twinkling
    // sun sparkles. (Caustics and foam were removed — caustic strength is forced
    // to 0 at runtime and foam never crossed its threshold, so both were pure
    // wasted ALU on this large water plane.)
    color = mix(color, shallowColor.rgb * 1.18, fresnel * 0.22);
    color += vec3(0.05, 0.10, 0.12) * max(v_wave, 0.0) * 0.95;

    // Sparse specular sparkle: a single non-harmonic travelling-wave product,
    // thresholded HIGH so only the rare brightest crests glint. This gives a few
    // discrete twinkling points of sunlight — NOT a dense flowing sheen — and is
    // slightly stronger toward grazing angles where real water flashes most.
    vec2 spk = v_worldPos.xz * 0.7 + baseWobble * 1.2;
    float s1 = sin(dot(spk, vec2( 1.70,  1.10))        + t * 1.90);
    float s2 = sin(dot(spk, vec2(-1.30,  1.90)) * 1.60 - t * 2.40);
    float s3 = sin(dot(spk, vec2( 2.10, -0.70)) * 2.30 + t * 2.10);
    float sparkle = smoothstep(0.86, 1.0, s1 * s2 * s3);
    sparkle *= 0.55 + 0.45 * fresnel;
    color += vec3(1.0) * sparkle * 0.35;

    // Keep the lockdown treatment in this material rather than adding world
    // meshes: it then survives the same refraction, water tint, and camera-layer
    // path as the rest of the pool surface.
    if (laneLockdownParams.w > 0.5) {
      float lowerSafe = smoothstep(
        laneLockdownParams.x - laneLockdownParams.z,
        laneLockdownParams.x + laneLockdownParams.z,
        v_worldPos.z
      );
      float upperSafe = 1.0 - smoothstep(
        laneLockdownParams.y - laneLockdownParams.z,
        laneLockdownParams.y + laneLockdownParams.z,
        v_worldPos.z
      );
      float safeMask = lowerSafe * upperSafe;
      float closedMask = 1.0 - safeMask;
      float edgeDistance = min(
        abs(v_worldPos.z - laneLockdownParams.x),
        abs(v_worldPos.z - laneLockdownParams.y)
      );
      float boundaryMask = 1.0 - smoothstep(
        laneLockdownParams.z,
        laneLockdownParams.z + 0.065,
        edgeDistance
      );
      color = mix(color, laneLockdownClosedColor.rgb, closedMask * laneLockdownClosedColor.a);
      color = mix(color, laneLockdownBoundaryColor.rgb, boundaryMask);
    }
    // The next contraction keeps the prior locked corridor visible and turns
    // every soon-to-close lane into a yellow-white flashing water mask.
    if (laneLockdownWarningParams.w > 0.5) {
      float pendingLowerSafe = smoothstep(
        laneLockdownWarningParams.x - laneLockdownWarningParams.z,
        laneLockdownWarningParams.x + laneLockdownWarningParams.z,
        v_worldPos.z
      );
      float pendingUpperSafe = 1.0 - smoothstep(
        laneLockdownWarningParams.y - laneLockdownWarningParams.z,
        laneLockdownWarningParams.y + laneLockdownWarningParams.z,
        v_worldPos.z
      );
      float pendingSafeMask = pendingLowerSafe * pendingUpperSafe;
      float currentSafeMask = 1.0;
      if (laneLockdownParams.w > 0.5) {
        float currentLowerSafe = smoothstep(
          laneLockdownParams.x - laneLockdownParams.z,
          laneLockdownParams.x + laneLockdownParams.z,
          v_worldPos.z
        );
        float currentUpperSafe = 1.0 - smoothstep(
          laneLockdownParams.y - laneLockdownParams.z,
          laneLockdownParams.y + laneLockdownParams.z,
          v_worldPos.z
        );
        currentSafeMask = currentLowerSafe * currentUpperSafe;
      }
      float closingLaneMask = (1.0 - pendingSafeMask) * currentSafeMask;
      float warningPulse = 0.5 + 0.5 * sin(t * 7.0);
      vec3 warningColor = mix(vec3(1.0, 0.72, 0.22), vec3(1.0, 0.98, 0.80), warningPulse);
      color = mix(color, warningColor, closingLaneMask * 0.82);
    }

    // The camera never sees the roof in normal race views, so do not pay for a
    // second camera or planar reflection. Instead, repeat small, cold-white
    // spots in world space, matching the sparse ceiling lamp grid rather than
    // implying a large mirrored roof. The existing refraction wobble bends the
    // spots without more texture samples, draw calls, or allocations.
    if (roofReflectionParams.w > 0.001) {
      vec2 lampSpacing = max(roofReflectionParams.xy, vec2(0.1));
      vec2 lampOffset = baseWobble * 3.4;
      vec2 lampDistance = abs(fract((v_worldPos.xz + lampOffset) / lampSpacing) - 0.5) * lampSpacing;
      // A slightly long X profile suggests a wavering reflected point of light,
      // while remaining far smaller than the old pool-length light strips.
      vec2 lampShape = lampDistance / vec2(roofReflectionParams.z * 1.9, roofReflectionParams.z);
      float lampMask = 1.0 - smoothstep(0.55, 1.0, dot(lampShape, lampShape));
      float reflection = lampMask * roofReflectionParams.w;
      color += roofReflectionColor.rgb * reflection * (0.55 + fresnel * 0.45);
    }
    // Mild overall lift so the surface reads bright and sunlit rather than dull.
    color *= 1.05;

    // Opaque: we composite the refracted floor ourselves. Swimmers are drawn on
    // top by a separate camera, so the water no longer needs to be see-through.
    float alpha = 1.0;

    vec4 o = vec4(color, alpha);
    CC_APPLY_FOG(o);
    return CCFragOutput(o);
  }
}%
